nomuvia.com {
    # Every response is private and uncached, except the audio of a stop, of the introduction and of the link clips: those answer with
    # their own Cache-Control (set by the backend, kept by the Next proxy), which is `immutable` only when the URL carries the version
    # of the file and `private, no-store` otherwise (plan 06 A6).
    @notAudio not path_regexp audio ^/api/backend/tours/[0-9a-f-]{36}/(audio/(introduction|[0-9a-f-]{36})|cue/.+)$
    header @notAudio Cache-Control "private, no-store"
    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
    @statisticsScript {
        path /statistics/script.js
        method GET HEAD
    }
    handle @statisticsScript {
        uri strip_prefix /statistics
        header X-Robots-Tag "noindex, nofollow"
        reverse_proxy 127.0.0.1:3002
    }
    @statisticsCollect {
        path /statistics/api/send
        method POST
    }
    handle @statisticsCollect {
        uri strip_prefix /statistics
        header X-Robots-Tag "noindex, nofollow"
        request_body {
            max_size 32KB
        }
        reverse_proxy 127.0.0.1:3002 {
            header_up X-Real-IP {remote_host}
            header_up -Cookie
            header_up -Authorization
        }
    }
    handle /statistics/* {
        header X-Robots-Tag "noindex, nofollow"
        respond 404
    }
    handle {
        reverse_proxy 127.0.0.1:3000 {
            header_up X-Pilot-Proxy-Token {$PILOT_PROXY_TOKEN}
            header_up -Authorization
            header_up -X-Middleware-Subrequest
            header_up -X-API-Key
        }
    }
}
www.nomuvia.com {
    redir https://nomuvia.com{uri} permanent
}
