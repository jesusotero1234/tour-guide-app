# Copy to deployment/.env.umami (never commit real credentials).
# Generate EACH secret independently: openssl rand -hex 32
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=
UMAMI_TWO_FACTOR_KEY=
# Set these on the FRONTEND process after registering the website in Umami.
# UMAMI_SCRIPT_URL=https://stats.your-domain.example/script.js
# UMAMI_WEBSITE_ID=<website UUID from Umami>
