PORT=3001
NODE_ENV=development
API_KEYS=development-api-key

# Offline editorial curator benchmark only
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
QWEN_LOCAL_BASE_URL=http://127.0.0.1:8080/v1
FIRECRAWL_BASE_URL=http://127.0.0.1:3007/v2
FIRECRAWL_API_KEY=
NARRATIVE_MODEL_PROFILE=qwen38_hybrid

# Service URLs
LLM_SERVICE_URL=http://localhost:3002
VERIFICATION_SERVICE_URL=http://localhost:3003
DESCRIPTION_SERVICE_URL=http://localhost:3004
TTS_SERVICE_URL=http://localhost:3005
TTS_POD_URL=http://localhost:3006
SUPABASE_SERVICE_URL=http://localhost:3006

# Local PostgreSQL (backend running inside Docker network)
DATABASE_URL=postgresql://tour_guide:tour_guide_dev@postgres-local:5432/tour_guide_local?schema=public

# Local PostgreSQL (backend running outside Docker, on host)
DATABASE_URL_LOCALHOST=postgresql://tour_guide:tour_guide_dev@localhost:5432/tour_guide_local?schema=public

# Prisma note:
# `prisma migrate dev` uses a shadow database and may require CREATEDB permission
# for the local migration role (e.g. tour_guide) in native WSL/local setups.
