{
  "name": "tour-guide-backend",
  "version": "1.0.0",
  "description": "Backend server for Tour Guide Application",
  "main": "src/server.ts",
  "scripts": {
    "start": "node dist/server.js",
    "predev": "bash ../scripts/firecrawl-local.sh up && bash ../scripts/searxng-local.sh up && tsc -p tsconfig.generation-worker.json && node scripts/build-narrative-assets.cjs",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc && tsc -p tsconfig.generation-worker.json && node scripts/build-narrative-assets.cjs",
    "test": "jest",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test:admin": "cd scripts/admin && python3 -m unittest discover -p 'test_*.py'",
    "test:node": "node -r ts-node/register/transpile-only --test scripts/validation/*.test.cjs scripts/admin/test_preparation_attempt.cjs scripts/admin/test_speech_stage.cjs",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .ts",
    "quality:narrative:v8:user-canary": "node -r ts-node/register scripts/validation/narrative-user-canary-v8.ts",
    "quality:narrative:v8:codex-author": "node -r ts-node/register scripts/validation/narrative-codex-author-v8.ts",
    "quality:test": "jest src/services/poi/TourQuality.acceptance.test.ts src/services/poi/PoiEnrichmentSnapshot.test.ts src/services/tourQuality/TourQualityEvaluator.test.ts --runInBand",
    "inventory:seed-flexible-pass": "tsx scripts/admin/seed-flexible-pass-inventory.ts",
    "audit:multi-route-overlap": "tsx scripts/audit/multi-route-overlap.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "ajv": "^8.20.0",
    "axios": "^1.20.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.25",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "ts-jest": "^29.1.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.4.2"
  }
}
