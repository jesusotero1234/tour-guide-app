{
  "name": "tour-guide-backend",
  "version": "1.0.0",
  "description": "Backend server for Tour Guide Application",
  "main": "src/server.ts",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .ts",
    "quality:capture": "tsx scripts/validation/capture-tour-fixtures.ts",
    "quality:capture:sources": "node -r ts-node/register scripts/validation/capture-source-snapshot-from-fixtures.ts",
    "quality:audit": "tsx scripts/validation/audit-tour-quality.ts",
    "quality:audit:text": "node -r ts-node/register scripts/validation/audit-tour-text.ts",
    "quality:regenerate": "tsx scripts/validation/regenerate-tour-from-fixtures.ts",
    "quality:route:v2": "node -r ts-node/register scripts/validation/route-editorial-v2.ts",
    "quality:route:v3": "node -r ts-node/register scripts/validation/route-editorial-v3.ts",
    "quality:route:v4": "node -r ts-node/register scripts/validation/route-editorial-v4.ts",
    "quality:route:v4:holdout": "node -r ts-node/register scripts/validation/route-editorial-v4-holdout.ts",
    "quality:route:v4:capture-holdout": "node -r ts-node/register scripts/validation/capture-editorial-holdout-sources-v4.ts",
    "quality:route:v5": "node -r ts-node/register scripts/validation/route-editorial-v5.ts",
    "quality:benchmark:editorial": "node -r ts-node/register scripts/validation/benchmark-editorial-curators.ts",
    "quality:preflight:history": "tsx scripts/validation/run-history-preflight-canary.ts",
    "quality:test": "jest src/services/poi/TourQuality.acceptance.test.ts src/services/poi/PoiEnrichmentSnapshot.test.ts src/services/tourQuality/TourQualityEvaluator.test.ts --runInBand",
    "inventory:seed-flexible-pass": "tsx scripts/admin/seed-flexible-pass-inventory.ts",
    "audit:multi-route-overlap": "tsx scripts/audit/multi-route-overlap.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.8.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.25",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "ts-jest": "^29.1.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.4.2"
  }
}
