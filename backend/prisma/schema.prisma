generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tour {
  id              String          @id @default(uuid()) @db.Uuid
  city            String
  country         String
  countryCode     String          @map("country_code")
  theme           String
  language        String
  durationMinutes Int             @map("duration_minutes")
  status          String          @default("draft")
  introduction    String?
  metadata        Json            @default("{}")
  blueprintId     String?         @map("blueprint_id") @db.Uuid
  blueprint       TourBlueprint?  @relation(fields: [blueprintId], references: [id], onDelete: Restrict)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at")
  places          Place[]
  generationJobs  GenerationJob[]

  @@index([blueprintId, language])
  @@map("tours")
}

model Place {
  id              String       @id @default(uuid()) @db.Uuid
  tourId          String       @map("tour_id") @db.Uuid
  name            String
  description     String
  latitude        Float        @map("lat")
  longitude       Float        @map("lng")
  position        Int
  importanceScore Float?       @map("importance_score")
  imageUrl        String?      @map("image_url")
  metadata        Json         @default("{}")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at")
  tour            Tour         @relation(fields: [tourId], references: [id], onDelete: Cascade)
  audioAssets     AudioAsset[]

  @@unique([tourId, position])
  @@map("places")
}

model AudioAsset {
  id              String   @id @default(uuid()) @db.Uuid
  placeId         String   @map("place_id") @db.Uuid
  language        String
  format          String
  storagePath     String   @map("storage_path")
  durationSeconds Int?     @map("duration_seconds")
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")
  place           Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@map("audio_assets")
}

model VoiceReferenceAudio {
  id              String   @id @default(uuid()) @db.Uuid
  language        String
  provider        String
  model           String
  voiceProfile    String   @map("voice_profile")
  format          String   @default("wav")
  storagePath     String   @map("storage_path")
  durationSeconds Float?   @map("duration_seconds")
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([language, provider, model, voiceProfile], name: "voice_reference_audio_identity_unique")
  @@index([language, provider, model], name: "voice_reference_audio_lookup_idx")
  @@map("voice_reference_audio")
}

model GenerationJob {
  id           String    @id @default(uuid()) @db.Uuid
  tourId       String?   @map("tour_id") @db.Uuid
  idempotencyKey String  @unique @map("idempotency_key")
  status       String
  step         String?
  request      Json      @default("{}")
  progress     Json      @default("{}")
  result       Json?
  errorCode    String?   @map("error_code")
  errorMessage String?   @map("error_message")
  errorDetails Json?     @map("error_details")
  attemptCount Int       @default(0) @map("attempt_count")
  accountedSpendUsd Float @default(0) @map("accounted_spend_usd")
  spendLimitUsd Float?   @map("spend_limit_usd")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  startedAt    DateTime? @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  leaseOwner   String?   @map("lease_owner")
  leaseExpiresAt DateTime? @map("lease_expires_at")
  tour         Tour?     @relation(fields: [tourId], references: [id], onDelete: SetNull)

  @@map("generation_jobs")
}

model PoiCache {
  id        String   @id @default(uuid()) @db.Uuid
  city      String
  theme     String
  fetchedAt DateTime @default(now()) @map("fetched_at")
  payload   Json

  @@unique([city, theme])
  @@map("poi_cache")
}

model PoiNarrationCache {
  poiId        String   @map("poi_id")
  language     String
  theme        String
  sections     Json
  narration    String
  modelVersion String   @map("model_version")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([poiId, language, theme])
  @@index([modelVersion])
  @@map("poi_narration_cache")
}

model CityConceptCache {
  id          String   @id @default(uuid()) @db.Uuid
  city        String
  countryCode String   @map("country_code")
  language    String
  payload     Json
  computedAt  DateTime @default(now()) @map("computed_at")
  expiresAt   DateTime @map("expires_at")

  @@unique([city, countryCode, language])
  @@map("city_concept_cache")
}

model EnrichmentCache {
  id        String   @id @default(uuid()) @db.Uuid
  city      String
  placeName String   @map("place_name")
  theme     String
  language  String
  query     String
  results   Json
  createdAt DateTime @default(now()) @map("created_at")
  ttlHours  Int      @default(720) @map("ttl_hours")

  @@unique([city, placeName, theme, language])
  @@map("enrichment_cache")
}

model TourConcept {
  id                       String   @id @default(uuid()) @db.Uuid
  city                     String
  countryCode              String   @map("country_code")
  language                 String
  slug                     String
  title                    String
  routeType                String   @map("route_type")
  angle                    String?
  iconKey                  String?  @map("icon_key")
  estimatedStops           Int      @map("estimated_stops")
  suggestedDurationMinutes Int      @map("suggested_duration_minutes")
  confidence               String
  status                   String   @default("draft")
  anchorPoiIds             Json     @map("anchor_poi_ids")
  supportingPoiIds         Json     @map("supporting_poi_ids")
  signals                  Json
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([city, countryCode, language, slug])
  @@map("tour_concepts")
}

model TourBlueprint {
  id                String   @id @default(uuid()) @db.Uuid
  baseKey           String   @map("base_key")
  revision          Int
  status            String
  snapshot          Json?
  revalidateAfter   DateTime? @map("revalidate_after")
  leaseOwner        String?   @map("lease_owner")
  leaseExpiresAt    DateTime? @map("lease_expires_at")
  attemptCount      Int       @default(0) @map("attempt_count")
  accountedSpendUsd Float     @default(0) @map("accounted_spend_usd")
  spendLimitUsd     Float     @map("spend_limit_usd")
  error             String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")
  tours             Tour[]

  @@unique([baseKey, revision])
  @@map("tour_blueprints")
}
