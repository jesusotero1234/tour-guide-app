# Copy to a private shell/environment source; never commit a real token.
HISTORICAL_CORPUS_ADMIN_TOKEN=replace-with-a-random-secret
HISTORICAL_CORPUS_PORT=3010

# Private absolute directory for import staging (must be an absolute path on the host)
HISTORICAL_CORPUS_IMPORT_DIR=/absolute/path/to/import-dir

# Runtime model backend and deterministic toggle
HISTORICAL_CORPUS_MODEL_BACKEND=qwen
HISTORICAL_CORPUS_ALLOW_DETERMINISTIC=false

# Model inference parameters
HISTORICAL_CORPUS_MODEL_BATCH_SIZE=8
HISTORICAL_CORPUS_MODEL_MAX_LENGTH=8192

# TurboVec index bit width (2, 3, or 4)
HISTORICAL_CORPUS_TURBOVEC_BIT_WIDTH=4

# Device override (empty means auto-select)
HISTORICAL_CORPUS_DEVICE=

# Model identifiers
HISTORICAL_CORPUS_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
HISTORICAL_CORPUS_RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B

# Container filesystem paths (consistent with Compose)
HISTORICAL_CORPUS_DATA_DIR=/data
HF_HOME=/model-cache/huggingface
PADDLEX_HOME=/model-cache/paddlex
